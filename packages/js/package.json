{
  "name": "mv-academic-calendar",
  "version": "0.1.3",
  "description": "Maldives school academic calendar and public holidays, 2015 to 2027, as a small offline JavaScript and TypeScript library. Terms, exams, holidays and iCalendar (ICS). No dependencies.",
  "license": "MIT AND CC-BY-4.0",
  "author": "grootismore",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ics": {
      "types": "./dist/ics.d.ts",
      "import": "./dist/ics.js",
      "require": "./dist/ics.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "DATA-LICENSE.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "sync": "python3 ../sync_data.py",
    "build": "npm run sync && node scripts/build.mjs",
    "test": "npm run build && node --test test/index.test.js",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grootismore/mv-academic-calendar.git",
    "directory": "packages/js"
  },
  "homepage": "https://github.com/grootismore/mv-academic-calendar#readme",
  "bugs": "https://github.com/grootismore/mv-academic-calendar/issues",
  "keywords": [
    "maldives",
    "maldives-calendar",
    "maldives-holidays",
    "maldives-public-holidays",
    "school-calendar",
    "academic-calendar",
    "school-holidays",
    "public-holidays",
    "holidays",
    "calendar",
    "ics",
    "icalendar",
    "ical",
    "json",
    "dataset",
    "open-data",
    "ministry-of-education",
    "typescript",
    "esm",
    "offline",
    "mv"
  ],
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
